// LocalCL — Modelo de datos
// Sprint 1: identidad y acceso. Las entidades de catálogo, credenciales
// y valoraciones se agregan en sus sprints correspondientes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Perfiles de usuario del sistema.
enum Rol {
  CLIENTE
  PRESTADOR
  ADMINISTRADOR
}

/// Propósitos de los tokens de un solo uso que se envían por correo.
/// El tipo se comprueba al canjear, de modo que un token de verificación no
/// sirva para restablecer una contraseña ni al revés.
enum TipoToken {
  VERIFICACION_CORREO
  RECUPERACION_CONTRASENA
}

/// Mecanismos de autenticación soportados.
/// CLAVE_UNICA queda declarado como trabajo futuro: su integración
/// está restringida a organismos del Estado.
enum ProveedorAuth {
  LOCAL
  GOOGLE
  CLAVE_UNICA
}

model Usuario {
  id               String   @id @default(uuid())
  correo           String   @unique
  /// Nulo cuando el usuario solo accede con un proveedor externo.
  hashContrasena   String?
  nombre           String
  /// Se almacena normalizado, sin puntos y con guion: 12345678-9
  rut              String?  @unique
  rutVerificado    Boolean  @default(false)
  rol              Rol      @default(CLIENTE)
  correoVerificado Boolean  @default(false)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  identidades      Identidad[]
  sesiones         Sesion[]
  tokens           TokenCuenta[]

  @@index([rol])
  @@map("usuarios")
}

/// Tokens de un solo uso que viajan por correo: verificación y recuperación.
/// Igual que en las sesiones, nunca se guarda el token en claro, solo su hash.
model TokenCuenta {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoToken
  /// SHA-256 del token que viaja en el enlace del correo.
  hashToken String    @unique
  expiraEn  DateTime
  /// Nulo mientras no se canjea. La fila no se borra al usarse: deja rastro
  /// para distinguir internamente "ya se usó" de "nunca existió".
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  @@index([usuarioId, tipo])
  @@index([expiraEn])
  @@map("tokens_cuenta")
}

/// Vincula un usuario con su cuenta en un proveedor de identidad.
/// Un usuario puede tener varias: contraseña local y Google, por ejemplo.
model Identidad {
  id            String        @id @default(uuid())
  usuarioId     String
  usuario       Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proveedor     ProveedorAuth
  /// Identificador que entrega el proveedor (el "sub" de OpenID Connect).
  sujetoExterno String
  creadoEn      DateTime      @default(now())

  @@unique([proveedor, sujetoExterno])
  @@index([usuarioId])
  @@map("identidades")
}

/// Tokens de refresco emitidos. Permiten cerrar sesiones de forma
/// remota y detectar la reutilización de un token ya consumido.
model Sesion {
  id            String    @id @default(uuid())
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Nunca se guarda el token en claro, solo su hash.
  hashToken     String    @unique
  expiraEn      DateTime
  revocadaEn    DateTime?
  /// Apunta a la sesión que la reemplazó al rotar el token.
  reemplazadaPor String?
  agenteUsuario String?
  creadaEn      DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}