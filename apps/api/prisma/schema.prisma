// LocalCL — Modelo de datos, normalizado hasta 3FN.
//
// Módulos, en el orden de sus migraciones: identidad y acceso, territorio,
// catálogo, credenciales, reputación y cumplimiento.
//
// Varias reglas viven solo en SQL dentro de las migraciones, porque Prisma no
// las expresa: CHECK, el índice único parcial de credenciales, la columna
// tsvector generada, la configuración de búsqueda "espanol_sin_tildes" y el
// trigger de solo inserción de la bitácora. Antes de cambiar una tabla,
// revisa su migración.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Perfiles de usuario del sistema.
enum Rol {
  CLIENTE
  PRESTADOR
  ADMINISTRADOR

  @@map("rol")
}

/// Propósitos de los tokens de un solo uso que se envían por correo.
/// El tipo se comprueba al canjear, de modo que un token de verificación no
/// sirva para restablecer una contraseña ni al revés.
enum TipoToken {
  VERIFICACION_CORREO
  RECUPERACION_CONTRASENA

  @@map("tipo_token")
}

/// Mecanismos de autenticación soportados.
/// CLAVE_UNICA queda declarado como trabajo futuro: su integración
/// está restringida a organismos del Estado.
enum ProveedorAuth {
  LOCAL
  GOOGLE
  CLAVE_UNICA

  @@map("proveedor_auth")
}

model Usuario {
  id               String    @id @default(uuid())
  correo           String    @unique
  /// Nulo cuando el usuario solo accede con un proveedor externo.
  hashContrasena   String?   @map("hash_contrasena")
  nombre           String
  /// Se almacena normalizado, sin puntos y con guion: 12345678-9
  rut              String?   @unique
  rutVerificado    Boolean   @default(false) @map("rut_verificado")
  rol              Rol       @default(CLIENTE)
  correoVerificado Boolean   @default(false) @map("correo_verificado")
  activo           Boolean   @default(true)
  /// Fecha en que la cuenta se anonimizó a pedido de su dueño. Las cuentas
  /// con historial (credenciales, contactos, valoraciones) no se borran:
  /// se vacían sus datos personales y la fila queda como ancla anónima.
  anonimizadoEn    DateTime? @map("anonimizado_en")
  creadoEn         DateTime  @default(now()) @map("creado_en")
  actualizadoEn    DateTime  @updatedAt @map("actualizado_en")

  identidades     Identidad[]
  sesiones        Sesion[]
  tokens          TokenCuenta[]
  perfilPrestador PerfilPrestador?

  credencialesVerificadas Credencial[]         @relation("VerificadorCredencial")
  eventosCredencial       EventoCredencial[]
  contactosComoCliente    Contacto[]
  denunciasHechas         Denuncia[]           @relation("Denunciante")
  denunciasRecibidas      Denuncia[]           @relation("UsuarioDenunciado")
  denunciasResueltas      Denuncia[]           @relation("ResolutorDenuncia")
  aceptacionesTerminos    AceptacionTerminos[]
  eventosSeguridad        EventoSeguridad[]
  accesosDocumento        AccesoDocumento[]
  moderacionesImagen      ModeracionImagen[]
  imagenesRevisadas       ImagenServicio[]     @relation("ImagenesRevisadas")
  decisionesReporte       DecisionReporte[]
  fotosPerfil             FotoPerfil[]
  contrataciones          Contratacion[]

  @@index([rol])
  @@map("usuarios")
}

// ─── Territorio ──────────────────────────────────────────────────────────

/// Regiones de Chile. La clave es el código oficial (CUT): estable,
/// público y el mismo que usan los registros con que se contrastan datos.
model Region {
  id       Int      @id
  nombre   String   @unique
  /// Orden geográfico de norte a sur, que no coincide con el código.
  orden    Int      @unique
  creadoEn DateTime @default(now()) @map("creado_en")

  comunas Comuna[]

  @@map("regiones")
}

/// Comunas. La región se obtiene por la relación, nunca se guarda como
/// texto en un perfil: así no existe la dependencia transitiva
/// perfil → comuna → región que rompería la 3FN.
model Comuna {
  /// Código Único Territorial, p. ej. 13101 para Santiago.
  id       Int      @id
  nombre   String
  regionId Int      @map("region_id")
  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  creadoEn DateTime @default(now()) @map("creado_en")

  perfiles               PerfilPrestador[]
  prestadoresQueAtienden PrestadorComuna[]

  @@unique([regionId, nombre])
  @@map("comunas")
}

/// Datos públicos del prestador, separados de la cuenta (usuarios), que
/// queda solo con identidad y acceso. Relación 1:1 con el usuario.
model PerfilPrestador {
  id              String                                @id @default(uuid())
  usuarioId       String                                @unique @map("usuario_id")
  usuario         Usuario                               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  descripcion     String?
  /// Formato E.164 chileno: +56 y 9 dígitos. Lo garantiza un CHECK.
  telefono        String?
  comunaId        Int                                   @map("comuna_id")
  comuna          Comuna                                @relation(fields: [comunaId], references: [id], onDelete: Restrict)
  /// Punto (longitud, latitud) en WGS 84. Prisma no maneja el tipo
  /// geography: se declara como no soportado para que las migraciones lo
  /// conozcan y no intenten borrarlo, y se consulta con $queryRaw.
  ubicacion       Unsupported("geography(Point,4326)")?
  /// Distancia máxima a la que atiende, en kilómetros (CHECK 1 a 200).
  radioAtencionKm Int                                   @default(10) @map("radio_atencion_km")
  creadoEn        DateTime                              @default(now()) @map("creado_en")
  actualizadoEn   DateTime                              @updatedAt @map("actualizado_en")

  servicios       Servicio[]
  credenciales    Credencial[]
  contactos       Contacto[]
  comunasAtencion PrestadorComuna[]
  contrataciones  Contratacion[]

  @@index([comunaId])
  @@index([ubicacion], type: Gist)
  @@map("perfiles_prestador")
}

/// Comunas donde atiende un prestador (N:M). Es independiente de la comuna
/// base del perfil (comunaId) y de su radio de atención: esos dos quedan para
/// la búsqueda por cercanía; esta lista es la que el prestador declara.
///
/// Clave primaria compuesta: una comuna no puede repetirse para el mismo
/// prestador. El máximo de 20 lo impone la API (un CHECK no puede contar filas).
model PrestadorComuna {
  prestadorId String          @map("prestador_id")
  prestador   PerfilPrestador @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  comunaId    Int             @map("comuna_id")
  comuna      Comuna          @relation(fields: [comunaId], references: [id], onDelete: Restrict)

  @@id([prestadorId, comunaId])
  /// Para la búsqueda futura "quién atiende en esta comuna".
  @@index([comunaId])
  @@map("prestadores_comunas")
}

// ─── Catálogo ────────────────────────────────────────────────────────────

/// Cómo se cobra un servicio. "A convenir" no es una unidad: se expresa
/// dejando los precios en nulo.
enum UnidadPrecio {
  POR_SERVICIO
  POR_HORA
  POR_DIA
  POR_METRO_CUADRADO
  POR_PERSONA

  @@map("unidad_precio")
}

/// Ciclo de vida de una publicación. Un servicio no se borra al dejar de
/// ofrecerse: puede tener contactos y denuncias que lo referencian.
enum EstadoServicio {
  BORRADOR
  PUBLICADO
  PAUSADO
  /// Ocultado por moderación, no por el prestador.
  OCULTO

  @@map("estado_servicio")
}

model Categoria {
  id            String   @id @default(uuid())
  /// Identificador estable para URLs y para el seed (p. ej. "gasfiteria").
  slug          String   @unique
  nombre        String   @unique
  activa        Boolean  @default(true)
  /// Posición en los listados; el seed la fija.
  orden         Int      @default(0)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  servicios Servicio[]

  @@map("categorias")
}

model Servicio {
  id                     String                      @id @default(uuid())
  prestadorId            String                      @map("prestador_id")
  prestador              PerfilPrestador             @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  categoriaId            String                      @map("categoria_id")
  categoria              Categoria                   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  titulo                 String
  descripcion            String
  /// Pesos chilenos, enteros: el peso no tiene decimales y un entero evita
  /// los errores de redondeo de un número de punto flotante.
  /// Nombre que escribe el prestador cuando su oficio no está en la lista
  /// y elige la categoría «Otros». Nulo en cualquier otra categoría: lo
  /// impone la API, porque un CHECK no puede mirar la tabla categorias.
  categoriaPersonalizada String?                     @map("categoria_personalizada")
  precioDesde            Int?                        @map("precio_desde")
  precioHasta            Int?                        @map("precio_hasta")
  unidadPrecio           UnidadPrecio?               @map("unidad_precio")
  estado                 EstadoServicio              @default(BORRADOR)
  /// Columna generada por la base a partir de título y descripción (ver la
  /// migración del catálogo). Prisma no la escribe nunca: solo existe para
  /// la búsqueda de texto completo con $queryRaw.
  ///
  /// El dbgenerated repite, carácter por carácter, la expresión tal como
  /// PostgreSQL la guarda. Sin él, Prisma cree que la expresión es un
  /// default sobrante y la próxima migración intentaría borrarlo.
  busqueda               Unsupported("tsvector")?    @default(dbgenerated("(setweight(to_tsvector('espanol_sin_tildes'::regconfig, COALESCE(titulo, ''::text)), 'A'::\"char\") || setweight(to_tsvector('espanol_sin_tildes'::regconfig, COALESCE(descripcion, ''::text)), 'B'::\"char\"))"))
  /// Vector del significado del servicio (búsqueda semántica, pgvector).
  /// Prisma no tiene el tipo vector: se escribe y se consulta solo con
  /// $queryRaw parametrizado (servicios.indexacion.ts y el buscador). Nulo
  /// si todavía no se calculó o si el proveedor falló: el servicio sigue
  /// apareciendo por la búsqueda de texto. El índice HNSW
  /// (vector_cosine_ops) vive en la migración: Prisma no lo expresa.
  embedding              Unsupported("vector(768)")?
  /// SHA-256 del texto que se vectorizó (y del proveedor que lo hizo). Si al
  /// editar el texto no cambió, el vector no se recalcula. Un CHECK exige
  /// que vector, hash y fecha estén los tres o ninguno.
  embeddingTextoHash     String?                     @map("embedding_texto_hash")
  embeddingActualizadoEn DateTime?                   @map("embedding_actualizado_en")
  creadoEn               DateTime                    @default(now()) @map("creado_en")
  actualizadoEn          DateTime                    @updatedAt @map("actualizado_en")

  contactos    Contacto[]
  denuncias    Denuncia[]
  imagenes     ImagenServicio[]
  valoraciones Valoracion[]
  /// Registros privados de clientes. No cuentan como historial al borrar el
  /// servicio (SET NULL): si bloquearan el borrado, el prestador deduciría
  /// que alguien lo marcó como contratado.
  contrataciones Contratacion[]

  /// Destino de la clave compuesta de contactos (servicio del mismo prestador).
  @@unique([id, prestadorId])
  @@index([prestadorId])
  @@index([categoriaId, estado])
  @@index([busqueda], type: Gin)
  /// Índice HNSW con vector_cosine_ops (búsqueda semántica). Prisma no sabe
  /// expresar HNSW ni la clase de operadores: el índice real lo crea la
  /// migración 20261113120000_busqueda_semantica. Se declara acá, tal como
  /// lo lee `prisma db pull`, solo para que Prisma sepa que existe y una
  /// migración futura no lo borre.
  @@index([embedding], map: "servicios_embedding_hnsw_idx")
  @@map("servicios")
}

/// Visibilidad de una imagen pública. Solo la moderación la oculta: el
/// prestador que no quiere una imagen la elimina.
enum EstadoImagen {
  VISIBLE
  OCULTA

  @@map("estado_imagen")
}

/// Fotos de trabajos anteriores de un servicio. Son PÚBLICAS y permanentes,
/// a diferencia de los documentos de identidad: viven en otra carpeta del
/// proveedor y con otra configuración de acceso.
///
/// Se borran en cascada con el servicio. El archivo del proveedor lo borra
/// la API al borrar el servicio (la base no puede llamar al proveedor).
///
/// Ocultar es moderación y es irreversible: la API borra el archivo del
/// proveedor (una URL pública pudo quedar guardada en cualquier parte), deja
/// la fila en OCULTA para que el prestador vea el motivo, y registra quién,
/// cuándo y por qué en moderaciones_imagen. La evidencia vive allá, no acá:
/// el prestador puede borrar la imagen oculta o el servicio entero sin
/// borrar el registro.
///
/// PENDIENTE (servicio de anonimización de cuentas): borrar una cuenta
/// borra en cascada perfil, servicios e imágenes, pero no sus archivos en el
/// proveedor, que quedan huérfanos. Ese servicio debe recorrer los
/// identificadores de sus imágenes VISIBLES y borrarlos del almacenamiento
/// público antes de borrar o anonimizar la cuenta.
model ImagenServicio {
  id            String       @id @default(uuid())
  servicioId    String       @map("servicio_id")
  servicio      Servicio     @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  /// Identificador del archivo en el proveedor (public_id de Cloudinary).
  /// Lo genera el servidor; el nombre que traía el archivo no se guarda.
  identificador String       @unique
  /// Posición en la galería, desde 0. La primera es la portada y la miniatura.
  orden         Int
  estado        EstadoImagen @default(VISIBLE)
  /// Cuándo y quién la revisó desde el panel de administración. Nulos: sin
  /// revisar. La foto se publica igual al subirla; esto solo ordena el
  /// trabajo del administrador («N imágenes por revisar» = VISIBLE y sin
  /// revisar). Un CHECK exige los dos o ninguno.
  revisadaEn    DateTime?    @map("revisada_en")
  revisadaPorId String?      @map("revisada_por_id")
  revisadaPor   Usuario?     @relation("ImagenesRevisadas", fields: [revisadaPorId], references: [id], onDelete: Restrict)
  creadoEn      DateTime     @default(now()) @map("creado_en")

  @@index([servicioId, orden])
  @@map("imagenes_servicio")
}

/// Bitácora de moderación de imágenes: cada vez que un administrador ocultó
/// una foto, con qué motivo y cuándo. Solo admite inserciones (el mismo
/// trigger que eventos_credencial y accesos_documento).
///
/// servicio_id, imagen_id e identificador_archivo se guardan como valores,
/// SIN clave foránea, a propósito: la evidencia tiene que sobrevivir a que
/// el prestador borre la imagen o el servicio. Una clave foránea obligaría a
/// elegir entre impedir ese borrado (RESTRICT), perder la evidencia
/// (CASCADE) o modificar la bitácora (SET NULL, que el trigger rechaza).
/// El administrador sí lleva clave foránea, RESTRICT: las cuentas de
/// administración no se borran mientras tengan acciones registradas.
model ModeracionImagen {
  id                   String   @id @default(uuid())
  servicioId           String   @map("servicio_id")
  imagenId             String   @map("imagen_id")
  /// Qué archivo se borró del proveedor (su public_id).
  identificadorArchivo String   @map("identificador_archivo")
  motivo               String
  administradorId      String   @map("administrador_id")
  administrador        Usuario  @relation(fields: [administradorId], references: [id], onDelete: Restrict)
  creadoEn             DateTime @default(now()) @map("creado_en")

  @@index([imagenId])
  @@index([servicioId, creadoEn])
  @@index([administradorId, creadoEn])
  @@map("moderaciones_imagen")
}

/// Tokens de un solo uso que viajan por correo: verificación y recuperación.
/// Igual que en las sesiones, nunca se guarda el token en claro, solo su hash.
model TokenCuenta {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoToken
  /// SHA-256 del token que viaja en el enlace del correo.
  hashToken String    @unique @map("hash_token")
  expiraEn  DateTime  @map("expira_en")
  /// Nulo mientras no se canjea. La fila no se borra al usarse: deja rastro
  /// para distinguir internamente "ya se usó" de "nunca existió".
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")

  @@index([usuarioId, tipo])
  @@index([expiraEn])
  @@map("tokens_cuenta")
}

/// Vincula un usuario con su cuenta en un proveedor de identidad.
/// Un usuario puede tener varias: contraseña local y Google, por ejemplo.
model Identidad {
  id            String        @id @default(uuid())
  usuarioId     String        @map("usuario_id")
  usuario       Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proveedor     ProveedorAuth
  /// Identificador que entrega el proveedor (el "sub" de OpenID Connect).
  sujetoExterno String        @map("sujeto_externo")
  creadoEn      DateTime      @default(now()) @map("creado_en")

  @@unique([proveedor, sujetoExterno])
  @@index([usuarioId])
  @@map("identidades")
}

/// Tokens de refresco emitidos. Permiten cerrar sesiones de forma
/// remota y detectar la reutilización de un token ya consumido.
model Sesion {
  id             String    @id @default(uuid())
  usuarioId      String    @map("usuario_id")
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Nunca se guarda el token en claro, solo su hash.
  hashToken      String    @unique @map("hash_token")
  expiraEn       DateTime  @map("expira_en")
  revocadaEn     DateTime? @map("revocada_en")
  /// Apunta a la sesión que la reemplazó al rotar el token.
  reemplazadaPor String?   @map("reemplazada_por")
  agenteUsuario  String?   @map("agente_usuario")
  creadaEn       DateTime  @default(now()) @map("creada_en")

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}

// ─── Credenciales ────────────────────────────────────────────────────────

enum MetodoVerificacion {
  /// Contrastada por el sistema contra el registro oficial.
  AUTOMATICO
  /// Revisada por un administrador.
  MANUAL

  @@map("metodo_verificacion")
}

/// El estado lo fija siempre el servidor, nunca el cliente (CLAUDE.md).
enum EstadoCredencial {
  PENDIENTE
  VERIFICADA
  RECHAZADA
  /// Pasó su fecha de vigencia. Lo marca un proceso del servidor.
  VENCIDA
  /// Anulada después de haber sido verificada (p. ej. el registro oficial
  /// la dio de baja, o fue reemplazada por una más reciente).
  REVOCADA

  @@map("estado_credencial")
}

/// Catálogo de credenciales que la plataforma sabe verificar.
model TipoCredencial {
  id                 String             @id @default(uuid())
  /// Clave estable para el código y el seed (p. ej. "SEC_ELECTRICO").
  codigo             String             @unique
  nombre             String
  /// Organismo que emite o registra la credencial (SEC, ChileValora...).
  fuenteOficial      String             @map("fuente_oficial")
  /// Método previsto para este tipo. Cada credencial guarda además el que
  /// se usó de verdad: si el registro oficial no responde, una automática
  /// puede terminar revisándose a mano.
  metodoVerificacion MetodoVerificacion @map("metodo_verificacion")
  requiereVigencia   Boolean            @map("requiere_vigencia")
  activo             Boolean            @default(true)
  creadoEn           DateTime           @default(now()) @map("creado_en")
  actualizadoEn      DateTime           @updatedAt @map("actualizado_en")

  credenciales Credencial[]

  @@map("tipos_credencial")
}

/// Una credencial presentada por un prestador.
///
/// Las referencias a prestador y verificador son RESTRICT: una credencial
/// es evidencia de lo que la plataforma afirmó en su momento, y no puede
/// desaparecer porque se elimine una cuenta. La cuenta se anonimiza.
model Credencial {
  id                     String              @id @default(uuid())
  prestadorId            String              @map("prestador_id")
  prestador              PerfilPrestador     @relation(fields: [prestadorId], references: [id], onDelete: Restrict)
  tipoId                 String              @map("tipo_id")
  tipo                   TipoCredencial      @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  estado                 EstadoCredencial    @default(PENDIENTE)
  /// Número de registro, folio o certificado tal como lo emite la fuente.
  /// Opcional solo para los cursos (lo impone la API).
  identificadorDocumento String?             @map("identificador_documento")
  /// Solo con el tipo «Otra certificación» (OTRA): el nombre y el emisor que
  /// escribe el prestador, porque no están en el catálogo. Nulos en el resto
  /// (lo impone la API; un CHECK exige que vayan los dos o ninguno).
  nombrePersonalizado    String?             @map("nombre_personalizado")
  emisorPersonalizado    String?             @map("emisor_personalizado")
  vigenteHasta           DateTime?           @map("vigente_hasta") @db.Date
  /// Solo cursos (tipo CURSO): cuándo lo terminó y cuántas horas duró.
  fechaTermino           DateTime?           @map("fecha_termino") @db.Date
  horas                  Int?
  /// Método con que efectivamente se verificó (nulo mientras está pendiente).
  metodo                 MetodoVerificacion?
  /// Fuente consultada al verificar, p. ej. la URL del registro público.
  fuente                 String?
  fechaConsulta          DateTime?           @map("fecha_consulta")
  /// Administrador que la revisó; nulo si la verificación fue automática.
  verificadoPorId        String?             @map("verificado_por_id")
  verificadoPor          Usuario?            @relation("VerificadorCredencial", fields: [verificadoPorId], references: [id], onDelete: Restrict)
  motivoRechazo          String?             @map("motivo_rechazo")
  /// Credencial anterior que esta reemplaza (renovación). Una credencial
  /// solo puede ser reemplazada una vez: de ahí el UNIQUE.
  reemplazaAId           String?             @unique @map("reemplaza_aid")
  reemplazaA             Credencial?         @relation("ReemplazoCredencial", fields: [reemplazaAId], references: [id], onDelete: Restrict)
  reemplazadaPor         Credencial?         @relation("ReemplazoCredencial")
  creadoEn               DateTime            @default(now()) @map("creado_en")
  actualizadoEn          DateTime            @updatedAt @map("actualizado_en")

  eventos    EventoCredencial[]
  extraccion ExtraccionDocumento?
  accesos    AccesoDocumento[]

  @@index([prestadorId, estado])
  @@index([tipoId])
  @@index([estado, vigenteHasta])
  @@map("credenciales")
}

/// Bitácora de cambios de estado. Solo admite inserciones: un trigger de la
/// base rechaza cualquier UPDATE o DELETE.
model EventoCredencial {
  id             String            @id @default(uuid())
  credencialId   String            @map("credencial_id")
  credencial     Credencial        @relation(fields: [credencialId], references: [id], onDelete: Restrict)
  /// Nulo en el evento de creación.
  estadoAnterior EstadoCredencial? @map("estado_anterior")
  estadoNuevo    EstadoCredencial  @map("estado_nuevo")
  /// Nulo cuando el cambio lo hizo el sistema (p. ej. el vencimiento).
  autorId        String?           @map("autor_id")
  autor          Usuario?          @relation(fields: [autorId], references: [id], onDelete: Restrict)
  motivo         String?
  creadoEn       DateTime          @default(now()) @map("creado_en")

  @@index([credencialId, creadoEn])
  @@map("eventos_credencial")
}

/// Bitácora de cada vez que un administrador pidió ver el documento que
/// respalda una credencial (p. ej. la cédula de identidad). Solo admite
/// inserciones: el mismo trigger que eventos_credencial rechaza UPDATE y
/// DELETE.
///
/// Es una tabla aparte y no un evento de credencial porque mirar un
/// documento no cambia su estado, y eventos_credencial exige que cambie.
/// Nunca guarda la URL firmada: solo quién, qué credencial y cuándo.
model AccesoDocumento {
  id              String     @id @default(uuid())
  credencialId    String     @map("credencial_id")
  credencial      Credencial @relation(fields: [credencialId], references: [id], onDelete: Restrict)
  administradorId String     @map("administrador_id")
  administrador   Usuario    @relation(fields: [administradorId], references: [id], onDelete: Restrict)
  creadoEn        DateTime   @default(now()) @map("creado_en")

  @@index([credencialId, creadoEn])
  @@index([administradorId, creadoEn])
  @@map("accesos_documento")
}

/// Qué documento lee la lectura automática; fija qué campos se extraen.
enum TipoDocumentoLectura {
  CEDULA
  CERTIFICADO
  CURSO

  @@map("tipo_documento_lectura")
}

enum EstadoExtraccion {
  PENDIENTE
  EXTRAIDA
  FALLIDA

  @@map("estado_extraccion")
}

enum ResultadoRevisionCampo {
  ACEPTADO
  CORREGIDO

  @@map("resultado_revision_campo")
}

/// Lo que la lectura automática leyó de un documento, para precargar la
/// revisión del administrador. NO decide nada: el estado de la credencial lo
/// cambia solo un administrador.
///
/// Vive mientras vive el documento: se borra en la misma transacción en que
/// se resuelve la solicitud y se elimina el archivo (y por CASCADE si se
/// borrara la credencial). De una cédula solo guarda nombre y RUT: lo
/// impone un CHECK (extracciones_documento_cedula_minima).
model ExtraccionDocumento {
  id           String               @id @default(uuid())
  credencialId String               @unique @map("credencial_id")
  credencial   Credencial           @relation(fields: [credencialId], references: [id], onDelete: Cascade)
  tipo         TipoDocumentoLectura
  estado       EstadoExtraccion     @default(PENDIENTE)
  /// [{ campo, valor, confianza }]. Nulo mientras no esté EXTRAIDA.
  campos       Json?
  modelo       String?
  intentos     Int                  @default(0)
  /// Motivo corto del último fallo; nunca contenido del documento.
  error        String?
  creadoEn     DateTime             @default(now()) @map("creado_en")
  extraidaEn   DateTime?            @map("extraida_en")

  @@index([estado, creadoEn])
  @@map("extracciones_documento")
}

/// Precisión de la lectura automática: por cada campo que revisó un
/// administrador, si lo aceptó tal cual o lo corrigió. Sin valores y sin
/// vínculo con la credencial ni con la persona: se conserva después de
/// borrar el documento porque no contiene datos personales. Solo admite
/// inserciones (trigger rechazar_modificacion_bitacora).
model RevisionExtraccion {
  id            String                 @id @default(uuid())
  /// Agrupa los campos de un mismo documento. Un identificador al azar.
  lote          String
  tipoDocumento TipoDocumentoLectura   @map("tipo_documento")
  campo         String
  confianza     Float
  resultado     ResultadoRevisionCampo
  modelo        String
  /// Cómo terminó la solicitud: VERIFICADA o RECHAZADA.
  decision      EstadoCredencial
  creadoEn      DateTime               @default(now()) @map("creado_en")

  @@index([tipoDocumento, campo])
  @@map("revisiones_extraccion")
}

// ─── Reputación ──────────────────────────────────────────────────────────

enum CanalContacto {
  WHATSAPP
  TELEFONO
  CORREO
  FORMULARIO

  @@map("canal_contacto")
}

enum EstadoValoracion {
  PUBLICADA
  /// Ocultada por moderación. No se borra: puede estar denunciada.
  OCULTA

  @@map("estado_valoracion")
}

/// Registro de que un cliente contactó a un prestador desde la plataforma.
/// Es la prueba de que hubo una relación real: solo quien contactó puede
/// valorar, y por eso la valoración cuelga del contacto.
model Contacto {
  id          String          @id @default(uuid())
  clienteId   String          @map("cliente_id")
  cliente     Usuario         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  prestadorId String          @map("prestador_id")
  prestador   PerfilPrestador @relation(fields: [prestadorId], references: [id], onDelete: Restrict)
  /// Nulo solo en contactos antiguos, hechos desde el perfil: desde las
  /// valoraciones por servicio, la API exige indicar el servicio (y una
  /// valoración exige un contacto CON servicio, ver Valoracion).
  /// La clave compuesta (servicioId, prestadorId) obliga a que el servicio
  /// sea de este mismo prestador. Es RESTRICT y no SET NULL: con una clave
  /// compuesta, SET NULL intentaría anular también prestadorId. Además un
  /// servicio no se borra al dejar de ofrecerse, cambia de estado.
  servicioId  String?         @map("servicio_id")
  servicio    Servicio?       @relation(fields: [servicioId, prestadorId], references: [id, prestadorId], onDelete: Restrict)
  canal       CanalContacto
  creadoEn    DateTime        @default(now()) @map("creado_en")

  /// En la base hay a lo más una (UNIQUE sobre valoraciones.contactoId).
  /// Prisma la ve como lista porque su 1:1 exigiría un índice único extra
  /// sobre los tres campos de la clave compuesta, redundante con ese UNIQUE.
  valoraciones Valoracion[]

  /// Destino de la clave foránea compuesta de valoraciones (ver abajo).
  @@unique([id, clienteId, prestadorId, servicioId])
  @@index([clienteId])
  @@index([prestadorId])
  @@index([servicioId])
  @@map("contactos")
}

/// Valoración de un contacto.
///
/// clienteId y prestadorId se repiten aquí para poder imponer con un UNIQUE
/// "una valoración por par cliente-prestador". Esa repetición no rompe la
/// 3FN porque la clave foránea compuesta (contactoId, clienteId,
/// prestadorId) → contactos obliga a que coincidan con los del contacto: la
/// base nunca acepta una combinación inconsistente.
model Valoracion {
  id            String           @id @default(uuid())
  contactoId    String           @unique @map("contacto_id")
  clienteId     String           @map("cliente_id")
  prestadorId   String           @map("prestador_id")
  /// El servicio valorado. La clave compuesta hacia contactos obliga a que
  /// sea EXACTAMENTE el servicio del contacto que habilita la valoración:
  /// nadie valora un servicio que no contactó, aunque sea del mismo
  /// prestador. RESTRICT al actualizar: un contacto no cambia de servicio
  /// bajo una valoración.
  servicioId    String           @map("servicio_id")
  contacto      Contacto         @relation(fields: [contactoId, clienteId, prestadorId, servicioId], references: [id, clienteId, prestadorId, servicioId], onDelete: Restrict, onUpdate: Restrict, map: "valoraciones_contacto_id_cliente_id_prestador_id_servicio_id_fk")
  servicio      Servicio         @relation(fields: [servicioId, prestadorId], references: [id, prestadorId], onDelete: Restrict, onUpdate: Restrict)
  /// 1 a 5, impuesto con CHECK.
  calificacion  Int
  comentario    String?
  estado        EstadoValoracion @default(PUBLICADA)
  /// Cuándo la editó su autor, solo en las anteriores a la regla de
  /// valoraciones definitivas: desde entonces queda nula y un trigger
  /// (valoraciones_contenido_inmutable) impide cambiarla, igual que la
  /// calificación y el comentario.
  editadaEn     DateTime?        @map("editada_en")
  creadoEn      DateTime         @default(now()) @map("creado_en")
  actualizadoEn DateTime         @updatedAt @map("actualizado_en")

  respuesta  RespuestaValoracion?
  denuncias  Denuncia[]
  decisiones DecisionReporte[]

  /// Una por cliente y SERVICIO: quien contactó dos servicios del mismo
  /// prestador puede valorar cada uno.
  @@unique([clienteId, servicioId])
  @@index([prestadorId, estado])
  @@index([servicioId, estado])
  @@map("valoraciones")
}

/// Respuesta del prestador a una valoración (1:1). El autor no se guarda:
/// es el prestador del contacto, y guardarlo aparte sería una dependencia
/// transitiva.
model RespuestaValoracion {
  id            String     @id @default(uuid())
  valoracionId  String     @unique @map("valoracion_id")
  valoracion    Valoracion @relation(fields: [valoracionId], references: [id], onDelete: Cascade)
  texto         String
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  @@map("respuestas_valoracion")
}

/// Registro PRIVADO de un servicio que el cliente dice haber contratado.
/// Es un historial personal, no una transacción: el prestador no lo
/// confirma, no lo ve y no se entera. Solo el módulo contrataciones lo lee,
/// y siempre filtrado por el cliente dueño.
///
/// tituloServicio y nombrePrestador son COPIAS deliberadas, tomadas al
/// registrar: si la publicación o la cuenta del prestador se borran, las
/// claves quedan en nulo (SET NULL) y el historial sigue legible. No rompen
/// la 3FN en la práctica: no dependen del servicio actual, sino del momento
/// del registro (son un hecho histórico, como el precio en una boleta).
///
/// servicioId y prestadorId son dos claves independientes y no una
/// compuesta: con una compuesta, SET NULL anularía también prestadorId al
/// borrarse solo el servicio. Que el servicio sea de ese prestador lo fija
/// la API, que copia el prestador desde el servicio, nunca desde el cliente.
///
/// CHECK en la base: la fecha no es futura (en hora de Chile) ni anterior a
/// 2000, las notas tienen a lo más 500 caracteres y las copias no son vacías.
model Contratacion {
  id                String           @id @default(uuid())
  clienteId         String           @map("cliente_id")
  /// CASCADE: si la cuenta del cliente se borra, su historial personal también.
  cliente           Usuario          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servicioId        String?          @map("servicio_id")
  servicio          Servicio?        @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  prestadorId       String?          @map("prestador_id")
  prestador         PerfilPrestador? @relation(fields: [prestadorId], references: [id], onDelete: SetNull)
  /// El día en que se contrató, que el cliente indica y puede corregir. No
  /// es la fecha del registro (creadoEn).
  fechaContratacion DateTime         @map("fecha_contratacion") @db.Date
  tituloServicio    String           @map("titulo_servicio")
  nombrePrestador   String           @map("nombre_prestador")
  notas             String?
  creadoEn          DateTime         @default(now()) @map("creado_en")
  actualizadoEn     DateTime         @updatedAt @map("actualizado_en")

  /// Un servicio recurrente se registra varias veces, en fechas distintas;
  /// la misma fecha dos veces es un doble envío. Con el servicio ya borrado
  /// (nulo) no aplica: PostgreSQL no compara nulos en un UNIQUE.
  @@unique([clienteId, servicioId, fechaContratacion])
  /// La lista del cliente: por fecha, la más reciente primero.
  @@index([clienteId, fechaContratacion(sort: Desc)])
  @@index([servicioId])
  @@index([prestadorId])
  @@map("contrataciones")
}

// ─── Cumplimiento ────────────────────────────────────────────────────────

/// Motivos cerrados de un reporte. OTRO exige un comentario (CHECK
/// denuncias_otro_con_detalle); en el resto el comentario es opcional.
enum MotivoDenuncia {
  CONTENIDO_ENGANOSO
  IMAGENES_INAPROPIADAS
  DATOS_DE_CONTACTO_EN_LA_DESCRIPCION
  SERVICIO_ILEGAL_O_PELIGROSO
  SUPLANTACION_DE_IDENTIDAD
  /// Motivos con que un prestador objeta una valoración recibida.
  LENGUAJE_OFENSIVO
  INFORMACION_FALSA
  DATOS_PERSONALES_EXPUESTOS
  NO_CORRESPONDE_A_UN_SERVICIO
  OTRO

  @@map("motivo_denuncia")
}

enum EstadoDenuncia {
  ABIERTA
  EN_REVISION
  /// Un administrador tomó una medida (p. ej. ocultó el servicio).
  RESUELTA
  /// Un administrador revisó y no tomó medidas.
  DESESTIMADA
  /// Quien reportó lo retiró antes de que se decidiera. La fila se conserva
  /// (no se borra) para que retirar y volver a reportar no esquive el
  /// límite diario. También queda así el reporte de una foto de perfil que
  /// su dueño cambió o quitó antes de la decisión: lo reportado ya no se
  /// muestra y no queda nada que decidir.
  RETIRADA

  @@map("estado_denuncia")
}

/// Denuncia sobre exactamente uno de cuatro objetos: una valoración, un
/// servicio, un usuario o una foto de perfil.
///
/// Son tres columnas con su propia clave foránea, y no un par genérico
/// (tipoObjeto, idObjeto): con el par genérico la base no puede comprobar
/// que el id exista, porque una clave foránea apunta a una sola tabla. Un
/// CHECK con num_nonnulls exige que haya exactamente una no nula.
///
/// Reglas que solo están en SQL (migración de reportes):
/// - un índice único parcial: una sola denuncia abierta por persona y
///   servicio (las retiradas o ya decididas no cuentan);
/// - un CHECK: con motivo OTRO, el detalle no puede quedar vacío.
///
/// estado, resolucion, resueltaPor y resueltaEn son el estado actual; la
/// historia inmutable de cada decisión está en decisiones_reporte (el mismo
/// par que credenciales y eventos_credencial).
model Denuncia {
  id            String         @id @default(uuid())
  denuncianteId String         @map("denunciante_id")
  denunciante   Usuario        @relation("Denunciante", fields: [denuncianteId], references: [id], onDelete: Restrict)
  motivo        MotivoDenuncia
  detalle       String?
  estado        EstadoDenuncia @default(ABIERTA)

  valoracionId        String?     @map("valoracion_id")
  valoracion          Valoracion? @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  servicioId          String?     @map("servicio_id")
  servicio            Servicio?   @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  usuarioDenunciadoId String?     @map("usuario_denunciado_id")
  usuarioDenunciado   Usuario?    @relation("UsuarioDenunciado", fields: [usuarioDenunciadoId], references: [id], onDelete: Restrict)
  fotoPerfilId        String?     @map("foto_perfil_id")
  fotoPerfil          FotoPerfil? @relation(fields: [fotoPerfilId], references: [id], onDelete: Restrict)

  resolucion    String?
  resueltaPorId String?   @map("resuelta_por_id")
  resueltaPor   Usuario?  @relation("ResolutorDenuncia", fields: [resueltaPorId], references: [id], onDelete: Restrict)
  resueltaEn    DateTime? @map("resuelta_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  @@index([estado, creadoEn])
  /// Para el límite diario: denuncias de una persona en las últimas 24 horas.
  @@index([denuncianteId, creadoEn])
  @@index([valoracionId])
  @@index([servicioId, estado])
  @@index([usuarioDenunciadoId])
  @@index([fotoPerfilId, estado])
  @@map("denuncias")
}

/// Qué decidió un administrador sobre los reportes de un servicio.
enum AccionReporte {
  /// Revisó y no hay nada que corregir: el servicio sigue publicado.
  DESESTIMAR
  /// Ocultó el servicio (estado OCULTO).
  OCULTAR_SERVICIO
  /// Ocultó una valoración objetada (estado OCULTA).
  OCULTAR_VALORACION
  /// Retiró una foto de perfil reportada (estado RETIRADA, archivo borrado).
  RETIRAR_FOTO_PERFIL

  @@map("accion_reporte")
}

/// Bitácora de las decisiones sobre reportes de servicios. Solo admite
/// inserciones (el mismo trigger que eventos_credencial).
///
/// Los reportes NUNCA ocultan un servicio por sí solos: cada fila de esta
/// tabla es una decisión que tomó una persona, con su motivo.
///
/// servicio_id va sin clave foránea, como en moderaciones_imagen: la
/// decisión tiene que seguir constando aunque el servicio deje de existir.
model DecisionReporte {
  id               String        @id @default(uuid())
  /// Sobre qué se decidió: un servicio, una valoración o una foto de
  /// perfil, exactamente uno (CHECK decisiones_reporte_exactamente_un_objeto).
  servicioId       String?       @map("servicio_id")
  valoracionId     String?       @map("valoracion_id")
  valoracion       Valoracion?   @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  fotoPerfilId     String?       @map("foto_perfil_id")
  fotoPerfil       FotoPerfil?   @relation(fields: [fotoPerfilId], references: [id], onDelete: Restrict)
  accion           AccionReporte
  motivo           String
  /// Cuántos reportes abiertos cerró esta decisión.
  reportesCerrados Int           @map("reportes_cerrados")
  administradorId  String        @map("administrador_id")
  administrador    Usuario       @relation(fields: [administradorId], references: [id], onDelete: Restrict)
  creadoEn         DateTime      @default(now()) @map("creado_en")

  @@index([servicioId, creadoEn])
  @@index([valoracionId, creadoEn])
  @@index([fotoPerfilId, creadoEn])
  @@index([administradorId, creadoEn])
  @@map("decisiones_reporte")
}

/// En qué quedó una foto de perfil.
enum EstadoFotoPerfil {
  /// La que la cuenta muestra ahora. A lo más una por cuenta (índice único
  /// parcial fotos_perfil_una_vigente_por_usuario).
  VIGENTE
  /// Su dueño la cambió por otra o la quitó.
  ELIMINADA
  /// Un administrador la retiró tras un reporte (motivo en decisiones_reporte).
  RETIRADA

  @@map("estado_foto_perfil")
}

/// Fotos de perfil de cualquier cuenta: cliente, prestador o administrador.
///
/// Se publican al subirlas, sin revisión previa: la moderación parte de un
/// reporte (denuncias.foto_perfil_id) y solo las reportadas llegan al panel.
///
/// Las filas no se borran: una foto que deja de estar VIGENTE conserva su
/// fila (los reportes y las decisiones apuntan a ella) pero su ARCHIVO se
/// borra del proveedor en ese momento, porque su URL es pública. Por eso
/// fin_en: cuándo dejó de mostrarse (CHECK fotos_perfil_fin_segun_estado).
model FotoPerfil {
  id            String           @id @default(uuid())
  usuarioId     String           @map("usuario_id")
  usuario       Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  /// Identificador del archivo en el proveedor. Lo genera el servidor.
  identificador String           @unique
  estado        EstadoFotoPerfil @default(VIGENTE)
  creadoEn      DateTime         @default(now()) @map("creado_en")
  finEn         DateTime?        @map("fin_en")

  denuncias  Denuncia[]
  decisiones DecisionReporte[]

  /// Para el límite diario y para saber cuál fue la última de la cuenta.
  @@index([usuarioId, creadoEn])
  @@map("fotos_perfil")
}

/// Cada versión publicada de los términos y condiciones. No se editan:
/// un cambio es una versión nueva, para saber qué aceptó cada quien.
model VersionTerminos {
  id           String   @id @default(uuid())
  /// Identificador legible y único, p. ej. "2026-10".
  version      String   @unique
  contenido    String
  vigenteDesde DateTime @map("vigente_desde")
  creadoEn     DateTime @default(now()) @map("creado_en")

  aceptaciones AceptacionTerminos[]

  @@map("versiones_terminos")
}

/// Relación N:M entre usuarios y versiones de términos. Es evidencia de
/// consentimiento, por eso no cae en cascada al borrar un usuario.
model AceptacionTerminos {
  usuarioId  String          @map("usuario_id")
  usuario    Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  versionId  String          @map("version_id")
  version    VersionTerminos @relation(fields: [versionId], references: [id], onDelete: Restrict)
  aceptadaEn DateTime        @default(now()) @map("aceptada_en")

  @@id([usuarioId, versionId])
  @@index([versionId])
  @@map("aceptaciones_terminos")
}

/// Hechos de seguridad para auditoría. No hay columna de detalle libre a
/// propósito: sin un lugar donde escribirlos, no se cuelan contraseñas,
/// tokens ni cuerpos de correo.
enum TipoEventoSeguridad {
  INICIO_SESION
  INICIO_SESION_FALLIDO
  CIERRE_SESION
  REUTILIZACION_TOKEN_REFRESCO
  CORREO_VERIFICADO
  RECUPERACION_SOLICITADA
  CONTRASENA_RESTABLECIDA
  CONTRASENA_CAMBIADA
  ACCESO_DENEGADO
  CUENTA_ANONIMIZADA

  @@map("tipo_evento_seguridad")
}

model EventoSeguridad {
  id            String              @id @default(uuid())
  tipo          TipoEventoSeguridad
  /// Opcional: un inicio de sesión fallido puede no corresponder a ninguna
  /// cuenta. SET NULL porque la bitácora de seguridad no es evidencia de
  /// la relación con terceros, y no debe impedir borrar una cuenta vacía.
  usuarioId     String?             @map("usuario_id")
  usuario       Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  agenteUsuario String?             @map("agente_usuario")
  creadoEn      DateTime            @default(now()) @map("creado_en")

  @@index([usuarioId, creadoEn])
  @@index([tipo, creadoEn])
  @@map("eventos_seguridad")
}
