NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localcl"
CORS_ORIGIN="http://localhost:5173"
# Mínimo 32 caracteres. Este valor es solo un ejemplo: genera el tuyo con
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# y guárdalo únicamente en .env, que no se versiona.
JWT_SECRET="cambiame-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Base pública de la web, para armar los enlaces que se envían por correo.
URL_WEB="http://localhost:5173"

# Correo saliente.
#   smtp       → Mailpit de docker-compose. No entrega nada al exterior y la
#                bandeja se ve en http://localhost:8025. Es lo normal en local.
#   memoria    → no envía nada, guarda en una lista. Lo usan las pruebas.
#   produccion → entrega de verdad por la API HTTP del proveedor.
CORREO_TRANSPORTE="smtp"
CORREO_SMTP_HOST="localhost"
CORREO_SMTP_PUERTO=1025

# Con transporte "produccion" tiene que ser EXACTAMENTE la dirección que
# verificaste en el panel del proveedor, o el envío se rechaza.
CORREO_REMITENTE="LocalCL <no-responder@localcl.cl>"

# Clave de la API del proveedor. Solo obligatoria con CORREO_TRANSPORTE=produccion.
# Se deja vacía acá a propósito: la real se configura en el panel del servicio
# donde corre la API y nunca se escribe en un archivo del repositorio.
CORREO_API_CLAVE=""

# Consulta a Have I Been Pwned al elegir contraseña (k-anonimato).
REVISAR_CONTRASENAS_FILTRADAS="true"

# Almacenamiento de documentos de identidad. "memoria" no sale a la red y se
# pierde al reiniciar la API: sirve para desarrollo. "produccion" usa
# Cloudinary con recursos privados.
ALMACENAMIENTO_TRANSPORTE="memoria"

# Solo obligatorias con ALMACENAMIENTO_TRANSPORTE=produccion. Igual que la clave
# del correo, las reales van en el panel del servicio donde corre la API.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Carpeta (dinámica) de la biblioteca de Cloudinary donde quedan los documentos.
CLOUDINARY_CARPETA_IDENTIDADES="localcl/identidades"

# Búsqueda semántica (embeddings).
#   determinista → deriva el vector de un hash del texto, sin red ni clave.
#                  Sirve para desarrollar sin cuenta de Google; los resultados
#                  por significado son solo aproximados.
#   gemini       → API de Google (modelo gemini-embedding-001). Es la que
#                  entiende «se me tapó el baño» como un destape.
EMBEDDINGS_PROVEEDOR="determinista"
# Solo se usa con EMBEDDINGS_PROVEEDOR=gemini. El valor de abajo es FICTICIO
# y no funciona: la clave real se crea en Google AI Studio y va únicamente en
# tu .env local y en el panel del servicio donde corre la API.
GEMINI_API_KEY="clave-ficticia-reemplazar-por-la-de-google-ai-studio"
EMBEDDINGS_MODELO="gemini-embedding-001"
# Debe ser 768: es el tamaño de la columna servicios.embedding.
EMBEDDINGS_DIMENSIONES=768
# Similitud de coseno mínima (0 a 1) para que un resultado entre por significado.
BUSQUEDA_UMBRAL_SIMILITUD=0.5
