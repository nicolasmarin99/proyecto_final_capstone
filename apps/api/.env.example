NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localcl"
CORS_ORIGIN="http://localhost:5173"
# Mínimo 32 caracteres. Este valor es solo un ejemplo: genera el tuyo con
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# y guárdalo únicamente en .env, que no se versiona.
JWT_SECRET="cambiame-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Base pública de la web, para armar los enlaces que se envían por correo.
URL_WEB="http://localhost:5173"

# Correo saliente.
#   smtp       → Mailpit de docker-compose. No entrega nada al exterior y la
#                bandeja se ve en http://localhost:8025. Es lo normal en local.
#   memoria    → no envía nada, guarda en una lista. Lo usan las pruebas.
#   produccion → entrega de verdad por la API HTTP del proveedor.
CORREO_TRANSPORTE="smtp"
CORREO_SMTP_HOST="localhost"
CORREO_SMTP_PUERTO=1025

# Con transporte "produccion" tiene que ser EXACTAMENTE la dirección que
# verificaste en el panel del proveedor, o el envío se rechaza.
CORREO_REMITENTE="LocalCL <no-responder@localcl.cl>"

# Clave de la API del proveedor. Solo obligatoria con CORREO_TRANSPORTE=produccion.
# Se deja vacía acá a propósito: la real se configura en el panel del servicio
# donde corre la API y nunca se escribe en un archivo del repositorio.
CORREO_API_CLAVE=""

# Consulta a Have I Been Pwned al elegir contraseña (k-anonimato).
REVISAR_CONTRASENAS_FILTRADAS="true"