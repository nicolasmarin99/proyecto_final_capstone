# LocalCL — Pruebas manuales de la API con la extensión REST Client.
#
# Requiere la API levantada con `npm run dev:api`, que usa la base de
# DESARROLLO (localcl), no la de pruebas. Los registros que se creen aquí
# quedan guardados. Para limpiarlos:
#   docker exec localcl-db psql -U postgres -d localcl -c "DELETE FROM usuarios WHERE correo LIKE '%@ejemplo.cl';"

@host = http://localhost:3000

### Estado del servicio → 200
GET {{host}}/health

### 1. Registro válido → 201, rol CLIENTE y sin hashContrasena
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Ana Pérez",
  "correo": "ana.perez@ejemplo.cl",
  "contrasena": "contrasena-segura-123"
}

### 2. Correo duplicado con otras mayúsculas → 409 REGISTRO_NO_DISPONIBLE
# Ejecutar después del caso 1. El correo se normaliza a minúsculas antes de
# guardarse, así que este choca con la restricción única.
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Ana Pérez",
  "correo": "ANA.PEREZ@Ejemplo.CL",
  "contrasena": "otra-contrasena-456"
}

### 3. Contraseña de 9 caracteres → 400 DATOS_INVALIDOS con detalle en contrasena
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Bruno Soto",
  "correo": "bruno.soto@ejemplo.cl",
  "contrasena": "123456789"
}

### 4. Contraseña de 129 caracteres → 400 DATOS_INVALIDOS
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Bruno Soto",
  "correo": "bruno.soto@ejemplo.cl",
  "contrasena": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### 5. Campos faltantes → 400 DATOS_INVALIDOS
POST {{host}}/auth/registro
Content-Type: application/json

{
  "correo": "carla.rojas@ejemplo.cl"
}

### 6. Correo con formato inválido → 400 DATOS_INVALIDOS
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Carla Rojas",
  "correo": "esto-no-es-un-correo",
  "contrasena": "contrasena-segura-123"
}

### 7. JSON mal formado → 400 JSON_INVALIDO
POST {{host}}/auth/registro
Content-Type: application/json

{"nombre": "Carla",

### 8. Rol enviado por el cliente → 201, pero se crea como CLIENTE
# El esquema no declara "rol", así que Zod descarta la clave y el servidor
# impone CLIENTE. La respuesta debe mostrar "rol": "CLIENTE".
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Diego Alarcón",
  "correo": "diego.alarcon@ejemplo.cl",
  "contrasena": "contrasena-segura-123",
  "rol": "ADMINISTRADOR"
}

### 9. Ruta inexistente → 404 NO_ENCONTRADO
GET {{host}}/auth/no-existe

# =====================================================================
# REGISTRO DE PRESTADORES
#
# El RUT se valida con el módulo 11 y se guarda normalizado
# ("12345678-5"), así que da lo mismo cómo se escriba al enviarlo.
# rutVerificado queda en false: el RUT está bien formado, pero nadie
# ha acreditado todavía que pertenezca a esa persona.
# =====================================================================

### 9a. Registro de prestador válido → 201, rol PRESTADOR, rutVerificado false
POST {{host}}/auth/registro-prestador
Content-Type: application/json

{
  "nombre": "Pedro Soto",
  "correo": "pedro.soto@ejemplo.cl",
  "contrasena": "contrasena-segura-123",
  "rut": "12.345.678-5"
}

### 9b. El mismo RUT sin puntos → 409 REGISTRO_NO_DISPONIBLE
# Demuestra la normalización: para la base es el mismo RUT que el 9a.
POST {{host}}/auth/registro-prestador
Content-Type: application/json

{
  "nombre": "Otro Nombre",
  "correo": "otro.prestador@ejemplo.cl",
  "contrasena": "contrasena-segura-123",
  "rut": "123456785"
}

### 9c. Correo duplicado → 409 con el MISMO cuerpo que el 9b
# Compara ambas respuestas: no se puede deducir si chocó el correo o el RUT.
POST {{host}}/auth/registro-prestador
Content-Type: application/json

{
  "nombre": "Pedro Soto",
  "correo": "pedro.soto@ejemplo.cl",
  "contrasena": "contrasena-segura-123",
  "rut": "7.654.321-6"
}

### 9d. Dígito verificador incorrecto → 400 con detalle en el campo rut
# Para este cuerpo el dígito correcto es 5, no 9.
POST {{host}}/auth/registro-prestador
Content-Type: application/json

{
  "nombre": "Pedro Soto",
  "correo": "nuevo.prestador@ejemplo.cl",
  "contrasena": "contrasena-segura-123",
  "rut": "12.345.678-9"
}

### 9e. Rol enviado por el cliente → 201, pero se crea como PRESTADOR
POST {{host}}/auth/registro-prestador
Content-Type: application/json

{
  "nombre": "Ambiciosa Prestadora",
  "correo": "ambiciosa@ejemplo.cl",
  "contrasena": "contrasena-segura-123",
  "rut": "18.765.432-7",
  "rol": "ADMINISTRADOR"
}

# =====================================================================
# INICIO DE SESIÓN
#
# REST Client guarda las cookies entre peticiones, así que lc_refresh
# viaja sola en refrescar y logout. El accessToken hay que copiarlo a
# mano en @token después del login, porque va en la cabecera.
# =====================================================================

@token = pega-aqui-el-accessToken-del-login

### 10. Login correcto → 200 { accessToken, usuario } + cookie lc_refresh
# Revisa en la respuesta que Set-Cookie traiga HttpOnly, SameSite=Strict y Path=/.
# Requiere haber ejecutado antes el caso 1.
POST {{host}}/auth/login
Content-Type: application/json

{
  "correo": "ana.perez@ejemplo.cl",
  "contrasena": "contrasena-segura-123"
}

### 11. Login con el correo en mayúsculas → 200 (se normaliza igual que el registro)
POST {{host}}/auth/login
Content-Type: application/json

{
  "correo": "  ANA.PEREZ@Ejemplo.CL  ",
  "contrasena": "contrasena-segura-123"
}

### 12. Contraseña incorrecta → 401 CREDENCIALES_INVALIDAS
POST {{host}}/auth/login
Content-Type: application/json

{
  "correo": "ana.perez@ejemplo.cl",
  "contrasena": "contrasena-equivocada"
}

### 13. Correo inexistente → 401 idéntico al caso 12
# Compara ambas respuestas: mismo estado, mismo cuerpo. No se puede deducir
# si la cuenta existe. El tiempo también debería ser parecido.
POST {{host}}/auth/login
Content-Type: application/json

{
  "correo": "no-existe@ejemplo.cl",
  "contrasena": "contrasena-segura-123"
}

### 14. Perfil autenticado → 200 (pega el accessToken en @token primero)
GET {{host}}/auth/yo
Authorization: Bearer {{token}}

### 15. Perfil sin token → 401 TOKEN_INVALIDO
GET {{host}}/auth/yo

### 16. Perfil con token alterado → 401 TOKEN_INVALIDO
GET {{host}}/auth/yo
Authorization: Bearer {{token}}xxx

### 17. Refrescar → 200 con accessToken nuevo y cookie lc_refresh distinta
# Usa la cookie guardada. La sesión anterior queda revocada y apuntando
# a la nueva mediante reemplazadaPor.
POST {{host}}/auth/refrescar

### 18. Refrescar otra vez → 200 (la rotación encadena sesiones)
POST {{host}}/auth/refrescar

### 19. Logout → 204 y la cookie se limpia
POST {{host}}/auth/logout

### 20. Refrescar después del logout → 401 SESION_INVALIDA
POST {{host}}/auth/refrescar

# =====================================================================
# DETECCIÓN DE ROBO DE TOKEN
#
# Este caso no se puede reproducir solo con las cookies automáticas,
# porque hay que reenviar a propósito una cookie ya rotada. Con curl:
#
#   # 1. Login guardando cookies y anotando el token de refresco
#   curl -s -c cookies.txt -X POST http://localhost:3000/auth/login \
#     -H "Content-Type: application/json" \
#     -d '{"correo":"ana.perez@ejemplo.cl","contrasena":"contrasena-segura-123"}'
#
#   # 2. Copiar el valor de lc_refresh de cookies.txt y refrescar con él
#   curl -s -X POST http://localhost:3000/auth/refrescar \
#     -H "Cookie: lc_refresh=VALOR_ANTIGUO"        # → 200
#
#   # 3. Reutilizar ese MISMO valor antiguo
#   curl -s -i -X POST http://localhost:3000/auth/refrescar \
#     -H "Cookie: lc_refresh=VALOR_ANTIGUO"        # → 401
#
#   # 4. Comprobar que no queda ninguna sesión activa del usuario
#   docker exec localcl-db psql -U postgres -d localcl \
#     -c "SELECT id, revocada_en, reemplazada_por FROM sesiones;"
# =====================================================================

# =====================================================================
# AUTORIZACIÓN POR ROL
#
# Para probar estos casos hace falta un administrador. El registro solo
# crea clientes (el rol lo fija el servidor), así que se promueve uno a
# mano en la base:
#
#   docker exec localcl-db psql -U postgres -d localcl -c \
#     "UPDATE usuarios SET rol='ADMINISTRADOR' WHERE correo='ana.perez@ejemplo.cl';"
#
# Después hay que volver a hacer login (caso 10) para obtener un token
# nuevo y pegarlo en @token.
# =====================================================================

### 21. Resumen de administración con token de ADMINISTRADOR → 200
GET {{host}}/admin/resumen
Authorization: Bearer {{token}}

### 22. Resumen sin token → 401 TOKEN_INVALIDO
GET {{host}}/admin/resumen

### 23. Resumen con token de CLIENTE → 403 SIN_PERMISOS
# Inicia sesión con una cuenta cliente, pega su token en @tokenCliente
# y ejecuta esta petición.
@tokenCliente = pega-aqui-el-accessToken-de-un-cliente

GET {{host}}/admin/resumen
Authorization: Bearer {{tokenCliente}}

# =====================================================================
# EL ROL SE LEE DE LA BASE, NO DEL TOKEN
#
# Con el token de administrador del caso 21 todavía en @token, degrada
# la cuenta SIN volver a iniciar sesión:
#
#   docker exec localcl-db psql -U postgres -d localcl -c \
#     "UPDATE usuarios SET rol='CLIENTE' WHERE correo='ana.perez@ejemplo.cl';"
#
# y repite el caso 21: el token sigue diciendo ADMINISTRADOR y su firma
# sigue siendo válida, pero la respuesta ya es 403. Lo mismo con:
#
#   UPDATE usuarios SET activo=false WHERE correo='ana.perez@ejemplo.cl';
#
# que devuelve 401 NO_AUTENTICADO, porque el problema deja de ser de
# permisos y pasa a ser que la sesión ya no representa a nadie válido.
# =====================================================================

# =====================================================================
# CORREO, VERIFICACIÓN Y RECUPERACIÓN
#
# Los enlaces no llegan a ninguna dirección real: los atrapa Mailpit.
# Ábrelo en http://localhost:8025, copia el token del enlace y pégalo
# en @tokenEnlace más abajo.
#
# OJO con el cambio de contrato: el registro ya NO devuelve 409 ante un
# correo duplicado. Responde 202 con el mismo cuerpo siempre, y al dueño
# del correo le llega un aviso. Los casos 1, 2, 9b y 9c de arriba siguen
# sirviendo, pero ahora todos responden 202.
# =====================================================================

@tokenEnlace = pega-aqui-el-token-del-enlace-que-ves-en-mailpit

### 21. Verificar el correo con el enlace recibido → 200
POST {{host}}/auth/verificar-correo
Content-Type: application/json

{ "token": "{{tokenEnlace}}" }

### 22. Reusar el mismo enlace → 400 ENLACE_INVALIDO
POST {{host}}/auth/verificar-correo
Content-Type: application/json

{ "token": "{{tokenEnlace}}" }

### 23. Token inventado → 400, respuesta idéntica al caso 22
POST {{host}}/auth/verificar-correo
Content-Type: application/json

{ "token": "este-token-nunca-existio" }

### 24. Reenviar la verificación → 202 (hay espera mínima de 2 minutos)
POST {{host}}/auth/reenviar-verificacion
Content-Type: application/json

{ "correo": "ana.perez@ejemplo.cl" }

### 25. Endpoint protegido por correo verificado, SIN verificar → 403
# Inicia sesión con una cuenta recién creada y pega su token en @token.
POST {{host}}/servicios
Authorization: Bearer {{token}}
Content-Type: application/json

{ "titulo": "Instalación eléctrica domiciliaria" }

### 26. El mismo endpoint tras verificar → 201
# Con el MISMO token de acceso: el estado se lee de la base, así que no
# hay que volver a iniciar sesión.
POST {{host}}/servicios
Authorization: Bearer {{token}}
Content-Type: application/json

{ "titulo": "Instalación eléctrica domiciliaria" }

### 27. Pedir recuperación → 202 (idéntico exista o no la cuenta)
POST {{host}}/auth/recuperar
Content-Type: application/json

{ "correo": "ana.perez@ejemplo.cl" }

### 28. Pedir recuperación de un correo inexistente → 202, cuerpo IDÉNTICO
POST {{host}}/auth/recuperar
Content-Type: application/json

{ "correo": "no-existe@ejemplo.cl" }

### 29. Restablecer con el enlace de recuperación → 200
# Copia el token del correo "Recupera el acceso" y pégalo en @tokenEnlace.
# Después de esto TODAS las sesiones quedan revocadas, incluida la tuya.
POST {{host}}/auth/restablecer
Content-Type: application/json

{
  "token": "{{tokenEnlace}}",
  "contrasena": "contrasena-nueva-456789"
}

### 30. Cambiar contraseña con sesión iniciada, con la actual MAL → 400
POST {{host}}/auth/cambiar-contrasena
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contrasenaActual": "equivocada",
  "contrasenaNueva": "otra-contrasena-987654"
}

### 31. Cambiar contraseña con la actual correcta → 200
# Cierra las demás sesiones y mantiene esta. Comprueba con:
#   docker exec localcl-db psql -U postgres -d localcl \
#     -c "SELECT left(id,8), revocada_en IS NULL AS activa FROM sesiones;"
POST {{host}}/auth/cambiar-contrasena
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contrasenaActual": "contrasena-segura-123",
  "contrasenaNueva": "otra-contrasena-987654"
}

# ─── Perfil de prestador y comunas ───────────────────────────────────────────
# Requisitos: npm run seed:maestros (carga las 346 comunas) y un prestador
# con el correo verificado (casos 9a y 21). Inicia sesión con él (caso 10) y
# pega su accessToken aquí.

@tokenPrestador = pega-aqui-el-accessToken-de-un-prestador-verificado

### 32. Comunas → 200, pública, 346 filas con su región, ordenadas por nombre
GET {{host}}/comunas

### 33. Mi perfil antes de crearlo → 404 PERFIL_NO_ENCONTRADO
GET {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}

### 34. Crear el perfil → 201, teléfono guardado como +56912345678
PUT {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}
Content-Type: application/json

{
  "descripcion": "Gasfíter con 10 años de experiencia en calefont y filtraciones.",
  "telefono": "9 1234 5678",
  "comunaId": 13101,
  "radioAtencionKm": 15
}

### 35. Editarlo → 200 y el MISMO id (no crea un segundo perfil)
PUT {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}
Content-Type: application/json

{
  "descripcion": "Gasfíter con 10 años de experiencia. Atiendo también en Ñuble.",
  "telefono": "+56 9 1234 5678",
  "comunaId": 16101,
  "radioAtencionKm": 40
}

### 36. Mi perfil después de crearlo → 200
GET {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}

### 37. Teléfono fijo → 400 DATOS_INVALIDOS con detalle en telefono
PUT {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}
Content-Type: application/json

{
  "descripcion": "Gasfíter con 10 años de experiencia en calefont y filtraciones.",
  "telefono": "2 2123 4567",
  "comunaId": 13101,
  "radioAtencionKm": 15
}

### 38. Comuna inexistente → 400 con detalle en comunaId
PUT {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}
Content-Type: application/json

{
  "descripcion": "Gasfíter con 10 años de experiencia en calefont y filtraciones.",
  "telefono": "9 1234 5678",
  "comunaId": 99999,
  "radioAtencionKm": 15
}

### 39. Descripción de 19 caracteres → 400 con detalle en descripcion
PUT {{host}}/prestadores/yo
Authorization: Bearer {{tokenPrestador}}
Content-Type: application/json

{
  "descripcion": "aaaaaaaaaaaaaaaaaaa",
  "telefono": "9 1234 5678",
  "comunaId": 13101,
  "radioAtencionKm": 15
}

### 40. Con token de CLIENTE → 403 SIN_PERMISOS
PUT {{host}}/prestadores/yo
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "descripcion": "Intento crear un perfil de prestador siendo cliente.",
  "telefono": "9 1234 5678",
  "comunaId": 13101,
  "radioAtencionKm": 15
}

