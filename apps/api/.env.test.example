# Entorno de pruebas de la API.
# Copiar a .env.test (ignorado por Git) antes de ejecutar las pruebas.
# La base localcl_test es independiente de la de desarrollo: las pruebas
# borran filas, por lo que nunca deben apuntar a localcl.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localcl_test"
CORS_ORIGIN="http://localhost:5173"
# Solo para pruebas: no necesita ser secreto, pero sí cumplir el mínimo de
# 32 caracteres que exige env.ts.
JWT_SECRET="secreto-solo-para-pruebas-de-integracion-local"

URL_WEB="http://localhost:5173"

# Las pruebas no levantan Mailpit: el transporte en memoria guarda lo enviado
# en una lista para poder afirmar sobre el asunto, el destinatario y el enlace.
CORREO_TRANSPORTE="memoria"
CORREO_REMITENTE="LocalCL <no-responder@localcl.cl>"

# Apagada en pruebas: no deben depender de la red.
REVISAR_CONTRASENAS_FILTRADAS="false"
